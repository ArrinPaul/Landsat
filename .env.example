# Runtime
NODE_ENV=development

# Session signing secret (min 32 chars, random). Required — auth will refuse to sign/verify without it.
JWT_SECRET=

# Set to "true" to make getAuthContext() throw instead of falling back to an anonymous viewer.
AUTH_REQUIRED=false

# Primary LLM provider (Gemini)
GEMINI_API_KEY=
# Optional alias used by some Genkit integrations
GOOGLE_GENAI_API_KEY=

# Fallback AI providers
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Google Earth Engine / Firebase Admin credentials JSON (single-line JSON string)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Supabase project (Settings -> API in the Supabase dashboard). Required — the
# app has no data layer without it. After creating the project, run every file
# in supabase/migrations/ (in order) via the Supabase SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


